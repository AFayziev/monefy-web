{
  "name": "monefy-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "wrangler dev",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types --env-file .env.example",
    "typecheck": "npm run types && tsc --noEmit && npm run typecheck -w web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate:local": "wrangler d1 migrations apply monefy --local",
    "db:migrate": "wrangler d1 migrations apply monefy --remote",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@clerk/hono": "^0.1.95",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.156.0"
  }
}
