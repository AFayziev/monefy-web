{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monefy-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-29",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "issues": {
      "enabled": false,
    },
  },
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "queues": {
    "producers": [
      {
        "binding": "IMPORT_QUEUE",
        "queue": "monefy-imports",
      },
    ],
    "consumers": [
      {
        "queue": "monefy-imports",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 3,
      },
    ],
  },
  // Refreshes exchange rates (worker/rates.ts).
  "triggers": {
    "crons": ["0 1 * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monefy",
      "database_id": "0f2a6ef8-d26c-4ec3-b24b-8f0ea8a0e31d",
      "migrations_dir": "migrations",
    },
  ],
  "workers_dev": true,
  "preview_urls": true,
  // No keys live in this file. Set these as Worker secrets (dashboard or `npx wrangler secret put <NAME>`):
  // API_KEY, CLERK_SECRET_KEY, PUBLIC_CLERK_PUBLISHABLE_KEY, GOOGLE_SERVICE_ACCOUNT,
  // EXCHANGE_RATES_URL, EXCHANGE_RATES_BASE
}
