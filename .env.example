# Copy to .env (git-ignored). Read by both `wrangler dev` and Vite.
API_KEY=change-me
CLERK_SECRET_KEY=sk_test_xxx
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
GOOGLE_SERVICE_ACCOUNT={"client_email":"x@y.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# Exchange rates feed: [{ Ccy, Rate, Nominal }], quoted in EXCHANGE_RATES_BASE.
EXCHANGE_RATES_URL=https://my.bank.site/exchange-rates/json/
EXCHANGE_RATES_BASE=USD
