# Copy to .env (git-ignored). Read by both `wrangler dev` and Vite.
API_KEY=change-me
CLERK_SECRET_KEY=sk_test_xxx
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
GOOGLE_SERVICE_ACCOUNT={"client_email":"x@y.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# Exchange rates feed: [{ Ccy, Rate, Nominal }], quoted in EXCHANGE_RATES_BASE.
EXCHANGE_RATES_URL=https://my.bank.site/exchange-rates/json/
EXCHANGE_RATES_BASE=USD
# Cloudflare AI Gateway (the Anthropic key itself is stored on the gateway, never here).
# CF_AIG_TOKEN is account-wide: keep it out of the browser and out of git.
AI_GATEWAY_ACCOUNT_ID=your-cloudflare-account-id
AI_GATEWAY_ID=monefy
CF_AIG_TOKEN=your-gateway-token
# Optional, private: what your own category/account names mean, for the "Ask your finances" assistant
# (max 2000 chars). One line; "\n" in double quotes makes a new line. Leave empty for none.
AI_CONTEXT_NOTES=
